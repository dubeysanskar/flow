# ==========================================
# WISPR FLOW STUDIO - ENVIRONMENT CONFIG
# ==========================================

# Database: Turso (LibSQL / SQLite)
# When deploying to production on Vercel or connecting to cloud Turso:
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# When TURSO_DATABASE_URL is left unset or empty, the app automatically 
# falls back to local embedded SQLite file storage: file:wispr_flow.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: Wispr Flow Referral Link
NEXT_PUBLIC_WISPR_REFERRAL_URL=https://ref.wisprflow.ai/hhg
